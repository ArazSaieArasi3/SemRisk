@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sr: <urn:semrisk:entity:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sr:SR-REL-037 a owl:ObjectProperty ;
    rdfs:label "pharmaEntityInRiskContext"@en ;
    dcterms:conformsTo "SR-REQ-014; SR-REQ-015" ;
    dcterms:identifier "SR-REL-037" ;
    dcterms:relation "CQ-020; CQ-033; CQ-034" ;
    rdfs:comment "Links a SemRisk Risk/Scenario/Event/etc. to a CM-PharmE-owned Pharma entity relevant to the case."@en ;
    skos:scopeNote "Bridge relation to externally owned CM-PharmE v1.0.0 entities. It does not change their identity or stereotype."@en .

<urn:semrisk:ontology:pharma> a owl:Ontology ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source "SemRisk issues #24 #25 #26 #43 #27" ;
    dcterms:title "SemRisk Bounded Pharma Profile"@en ;
    owl:imports <urn:semrisk:ontology:core:0.2.0-rc.3>,
        <urn:semrisk:ontology:enterprise:0.2.0-rc.3> ;
    owl:versionIRI <urn:semrisk:ontology:pharma:0.2.0-rc.3> ;
    owl:versionInfo "0.2.0-rc.3" .

