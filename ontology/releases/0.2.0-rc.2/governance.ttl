@prefix sr: <urn:semrisk:entity:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:semrisk:ontology:governance> a owl:Ontology ;
  owl:versionIRI <urn:semrisk:ontology:governance:0.2.0-rc.2> ;
  owl:versionInfo "0.2.0-rc.2" ;
  dcterms:title "SemRisk Governance Profile"@en ;
  dcterms:created "2026-10-05"^^xsd:date ;
  dcterms:source "SemRisk issues #24 #25 #26 #43 #27" ;
  owl:imports <urn:semrisk:ontology:core:0.2.0-rc.2>;
  owl:imports <urn:semrisk:ontology:method:0.2.0-rc.2> .

sr:SR-REL-035 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-035" ;
  rdfs:label "hasIndicator"@en ;
  rdfs:comment "Links a Risk/context/process to an Indicator used for monitoring."@en ;
  dcterms:conformsTo "SR-REQ-008; SR-REQ-012" ;
  dcterms:relation "CQ-006" ;
  rdfs:range sr:SR-CPT-024 .

sr:SR-REL-036 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-036" ;
  rdfs:label "hasThreshold"@en ;
  rdfs:comment "Links an Indicator/Assessment Method/Risk Criteria to a Threshold."@en ;
  dcterms:conformsTo "SR-REQ-013" ;
  dcterms:relation "CQ-019; CQ-032" ;
  rdfs:range sr:SR-CPT-025 ;
  skos:scopeNote "Threshold comparison/classification is rule/profile semantics, not an OWL truth."@en .

