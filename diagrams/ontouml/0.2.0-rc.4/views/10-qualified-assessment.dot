digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.42", ranksep="0.65", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=14];
edge [fontname="Helvetica", fontsize=11, color="#526477", arrowsize=0.65];
"H-ArtifactVersion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#40546c" BGCOLOR="#e8f5f0"><TR><TD><FONT POINT-SIZE="11">«subkind»</FONT></TD></TR><TR><TD><B>Artifact Version</B></TD></TR></TABLE>>];
"H-ControlBaseline" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#40546c" BGCOLOR="#e8f5f0"><TR><TD><FONT POINT-SIZE="11">«enumeration»</FONT></TD></TR><TR><TD><B>Control Baseline</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">BeforeControl<BR ALIGN="LEFT"/>AfterControl</FONT></TD></TR></TABLE>>];
"H-Dimension" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#40546c" BGCOLOR="#e8f5f0"><TR><TD><FONT POINT-SIZE="11">«enumeration»</FONT></TD></TR><TR><TD><B>Assessment Dimension</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Likelihood<BR ALIGN="LEFT"/>Impact<BR ALIGN="LEFT"/>RiskLevel</FONT></TD></TR></TABLE>>];
"H-EvaluationBasis" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#40546c" BGCOLOR="#e8f5f0"><TR><TD><FONT POINT-SIZE="11">«enumeration»</FONT></TD></TR><TR><TD><B>Evaluation Basis</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Observed<BR ALIGN="LEFT"/>Projected</FONT></TD></TR></TABLE>>];
"H-NumericScale" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#40546c" BGCOLOR="#e8f5f0"><TR><TD><FONT POINT-SIZE="11">«subkind»</FONT></TD></TR><TR><TD><B>Numeric Scale Version</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">minimum: decimal [1]<BR ALIGN="LEFT"/>maximum: decimal [1]</FONT></TD></TR></TABLE>>];
"H-QualifiedAssessmentResult" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#40546c" BGCOLOR="#e8f5f0"><TR><TD><FONT POINT-SIZE="11">«subkind»</FONT></TD></TR><TR><TD><B>Qualified Assessment<BR/>Result</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">numericValue: decimal [1]<BR ALIGN="LEFT"/>methodVersion: string [1]<BR ALIGN="LEFT"/>assessedAt: dateTime [1]<BR ALIGN="LEFT"/>referenceTime: dateTime [1]</FONT></TD></TR></TABLE>>];
"SR-CPT-012" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#40546c" BGCOLOR="#e7f2fc"><TR><TD><FONT POINT-SIZE="11">«subkind»</FONT></TD></TR><TR><TD><B>Risk Assessment<BR/>Method</B></TD></TR></TABLE>>];
"SR-CPT-012" -> "H-ArtifactVersion" [arrowhead=empty, color="#34465d", id="GEN-SR-CPT-012-H-ArtifactVersion"];
"H-NumericScale" -> "H-ArtifactVersion" [arrowhead=empty, color="#34465d", id="GEN-H-NumericScale-H-ArtifactVersion"];
"H-QualifiedAssessmentResult" -> "H-Dimension" [arrowhead=none, label="dimension", taillabel="0..*", headlabel="1", labeldistance=1.8, color="#147e74", fontcolor="#147e74", id="HP-dimension"];
"H-QualifiedAssessmentResult" -> "H-ControlBaseline" [arrowhead=none, label="controlBaseline", taillabel="0..*", headlabel="1", labeldistance=1.8, color="#147e74", fontcolor="#147e74", id="HP-controlBaseline"];
"H-QualifiedAssessmentResult" -> "H-EvaluationBasis" [arrowhead=none, label="evaluationBasis", taillabel="0..*", headlabel="1", labeldistance=1.8, color="#147e74", fontcolor="#147e74", id="HP-evaluationBasis"];
"H-QualifiedAssessmentResult" -> "SR-CPT-012" [arrowhead=none, label="method", taillabel="0..*", headlabel="1", labeldistance=1.8, color="#147e74", fontcolor="#147e74", id="HP-method"];
"H-QualifiedAssessmentResult" -> "H-NumericScale" [arrowhead=none, label="scale", taillabel="0..*", headlabel="1", labeldistance=1.8, color="#147e74", fontcolor="#147e74", id="HP-scale"];
"H-NumericScale" -> "H-Dimension" [arrowhead=none, label="dimension", taillabel="0..*", headlabel="1", labeldistance=1.8, color="#147e74", fontcolor="#147e74", id="HP-scale-dimension"];
}
