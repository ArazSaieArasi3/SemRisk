PREFIX ist: <urn:semrisk:profile:information-state:>
PREFIX ac: <urn:semrisk:profile:assessment-context:>
# Bind ?asOf explicitly to a timezone-qualified xsd:dateTime. Validate the strict profile first.
# Unqualified SR-REL-030 snapshots are intentionally not historical evidence.
SELECT DISTINCT ?record ?scheme ?value WHERE {
 ?assignment a ist:WorkflowAssignment ; ist:record ?record ; ist:scheme ?scheme ; ist:value ?value ; ac:validFrom ?start .
 ?value ist:inScheme ?scheme .
 OPTIONAL { ?assignment ac:validTo ?end }
 FILTER(?start <= ?asOf && (!BOUND(?end) || ?asOf < ?end))
}
