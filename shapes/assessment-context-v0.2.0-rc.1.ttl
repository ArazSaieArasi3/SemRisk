@prefix ac: <urn:semrisk:profile:assessment-context:> .
@prefix sr: <urn:semrisk:entity:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
ac:ResultShape a sh:NodeShape ; sh:targetClass ac:QualifiedAssessmentResult ;
 sh:targetSubjectsOf ac:assessedAt, ac:referenceTime, ac:controlBaseline, ac:evaluationBasis, ac:scale, ac:method, ac:methodVersion, ac:numericValue ;
 sh:class ac:QualifiedAssessmentResult ;
 sh:property [ sh:path sr:SR-REL-016 ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sr:SR-CPT-001 ] ;
 sh:property [ sh:path [ sh:inversePath sr:SR-REL-015 ] ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sr:SR-CPT-011 ] ;
 sh:property [ sh:path ac:dimension ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (ac:Likelihood ac:Impact ac:RiskLevel) ] ;
 sh:property [ sh:path ac:controlBaseline ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (ac:BeforeControl ac:AfterControl) ] ;
 sh:property [ sh:path ac:evaluationBasis ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (ac:Observed ac:Projected) ] ;
 sh:property [ sh:path ac:scale ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ac:NumericScale ; sh:node ac:ScaleShape ] ;
 sh:property [ sh:path ac:method ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sr:SR-CPT-012 ] ;
 sh:property [ sh:path ac:methodVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
 sh:property [ sh:path ac:numericValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
 sh:property [ sh:path ac:assessedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] ;
 sh:property [ sh:path ac:referenceTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] ;
 sh:sparql [ sh:message "CTX_RANGE: Numeric value or dimension conflicts with declared scale." ; sh:select """
 PREFIX ac: <urn:semrisk:profile:assessment-context:>
 SELECT $this WHERE { $this ac:numericValue ?v; ac:dimension ?d; ac:scale ?s .
 ?s ac:minimum ?lo; ac:maximum ?hi; ac:dimension ?sd . FILTER(?v < ?lo || ?v > ?hi || ?d != ?sd) }
 """ ] ;
 sh:sparql [ sh:message "CTX_METHOD: Producing activity, result risk and method/version must agree." ; sh:select """
 PREFIX ac: <urn:semrisk:profile:assessment-context:>
 PREFIX sr: <urn:semrisk:entity:>
 PREFIX dct: <http://purl.org/dc/terms/>
 SELECT $this WHERE { $this sr:SR-REL-016 ?risk; ac:method ?m; ac:methodVersion ?v .
 FILTER NOT EXISTS { ?a sr:SR-REL-015 $this; sr:SR-REL-013 ?risk; sr:SR-REL-014 ?m . ?m dct:hasVersion ?v . }
 }
 """ ] ;
 sh:sparql [ sh:message "CTX_LINEAGE: Supersession must be acyclic and concern the same risk; known assessment time must not go backwards." ; sh:select """
 PREFIX ac: <urn:semrisk:profile:assessment-context:>
 PREFIX sr: <urn:semrisk:entity:>
 SELECT $this WHERE {
 { $this sr:SR-REL-033+ $this . }
 UNION { $this sr:SR-REL-033 ?old; sr:SR-REL-016 ?risk . FILTER NOT EXISTS { ?old sr:SR-REL-016 ?risk } }
 UNION { $this sr:SR-REL-033 ?old; ac:assessedAt ?newTime . ?old ac:assessedAt ?oldTime . FILTER(?newTime < ?oldTime) }
 }
 """ ] .
ac:ScaleShape a sh:NodeShape ; sh:targetClass ac:NumericScale ;
 sh:property [ sh:path ac:minimum ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:lessThanOrEquals ac:maximum ] ;
 sh:property [ sh:path ac:maximum ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
 sh:property [ sh:path ac:dimension ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (ac:Likelihood ac:Impact ac:RiskLevel) ] ;
 sh:property [ sh:path dct:hasVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .
ac:MethodShape a sh:NodeShape ; sh:targetObjectsOf ac:method ; sh:class sr:SR-CPT-012 ;
 sh:property [ sh:path dct:hasVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .
ac:ActivityShape a sh:NodeShape ; sh:targetSubjectsOf sr:SR-REL-015 ; sh:class sr:SR-CPT-011 ;
 sh:property [ sh:path sr:SR-REL-013 ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sr:SR-CPT-001 ] ;
 sh:property [ sh:path sr:SR-REL-014 ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sr:SR-CPT-012 ] .
ac:ResultTypeShape a sh:NodeShape ; sh:targetClass ac:QualifiedAssessmentResult ;
 sh:sparql [ sh:message "CTX_TYPE: Qualified axes contradict asserted result subtype." ; sh:select """
 PREFIX ac: <urn:semrisk:profile:assessment-context:>
 PREFIX sr: <urn:semrisk:entity:>
 SELECT $this WHERE {
 { $this a sr:SR-CPT-014; ac:dimension ?d . FILTER(?d != ac:Likelihood) }
 UNION { $this a sr:SR-CPT-015; ac:dimension ?d . FILTER(?d != ac:Impact) }
 UNION { $this a sr:SR-CPT-016; ac:dimension ?d . FILTER(?d != ac:RiskLevel) }
 UNION { $this a sr:SR-CPT-017; ac:controlBaseline ?b . FILTER(?b != ac:BeforeControl) }
 UNION { $this a sr:SR-CPT-018; ac:controlBaseline ?b . FILTER(?b != ac:AfterControl) }
 }
 """ ] .
ac:ResponsibilityShape a sh:NodeShape ; sh:targetClass sr:SR-CPT-031 ;
 sh:property [ sh:path sr:SR-REL-027 ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sr:SR-CPT-001 ] ;
 sh:property [ sh:path sr:SR-REL-028 ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
 sh:property [ sh:path ac:validFrom ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ; sh:lessThan ac:validTo ] ;
 sh:property [ sh:path ac:validTo ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] ;
 sh:property [ sh:path prov:invalidatedAtTime ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] .
