@prefix tp: <urn:semrisk:profile:temporal:v0.1:> .
@prefix sr: <urn:semrisk:entity:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
tp: a owl:Ontology ; dct:title "SemRisk temporal companion prototype v0.1" ;
 rdfs:comment "Synthetic executable contract; not imported by the publication candidate." .
tp:assessedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
tp:referenceTime a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
tp:validFrom a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
tp:validTo a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
tp:dimension a owl:ObjectProperty .
tp:controlBaseline a owl:ObjectProperty .
tp:evaluationBasis a owl:ObjectProperty .
tp:scale a owl:ObjectProperty .
tp:numericValue a owl:DatatypeProperty ; rdfs:range xsd:decimal .
tp:minimum a owl:DatatypeProperty ; rdfs:range xsd:decimal .
tp:maximum a owl:DatatypeProperty ; rdfs:range xsd:decimal .
