@prefix ex: <urn:semrisk:test:grounded-owner:> .
@prefix sr: <urn:semrisk:entity:> .
@prefix ac: <urn:semrisk:profile:assessment-context:> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
ex:fixture dct:description "Synthetic person/organization placeholders only; no real identities or authority claims." .
ex:risk a sr:SR-CPT-001 .
ex:person a gufo:Endurant ; owl:differentFrom ex:organization, ex:board .
ex:organization a gufo:Endurant ; owl:differentFrom ex:board .
ex:board a gufo:Endurant .
ex:personAssignment a sr:SR-CPT-031, ac:GroundedRiskResponsibility ;
  sr:SR-REL-027 ex:risk ; sr:SR-REL-028 ex:person ;
  gufo:mediates ex:person, ex:organization ;
  ac:validFrom "2026-10-01T00:00:00Z"^^xsd:dateTime ;
  ac:validTo "2026-10-06T00:00:00Z"^^xsd:dateTime .
ex:organizationAssignment a sr:SR-CPT-031, ac:GroundedRiskResponsibility ;
  sr:SR-REL-027 ex:risk ; sr:SR-REL-028 ex:organization ;
  gufo:mediates ex:organization, ex:board ;
  ac:validFrom "2026-10-05T00:00:00Z"^^xsd:dateTime .
# Deliberately permissive legacy case: never returned by the opt-in entrypoint.
ex:legacyAssignment a sr:SR-CPT-031 ; sr:SR-REL-027 ex:risk ;
  sr:SR-REL-028 sr:SR-CPT-030 ;
  ac:validFrom "2026-10-01T00:00:00Z"^^xsd:dateTime .
