@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sr: <urn:semrisk:entity:> .
@prefix es: <urn:semrisk:shape:exposure-scale:> .
@prefix ac: <urn:semrisk:profile:assessment-context:> .
@prefix ist: <urn:semrisk:profile:information-state:> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
es:ExposureShape a sh:NodeShape ;
 sh:targetClass sr:SR-CPT-010 ; sh:targetSubjectsOf sr:SR-REL-039, sr:SR-REL-040 ;
 sh:nodeKind sh:IRI ; sh:class sr:SR-CPT-010 ;
 sh:not [ sh:class sr:SR-CPT-013 ] ; sh:not [ sh:class gufo:QualityValue ] ;
 sh:property [ sh:path sr:SR-REL-039 ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class sr:SR-CPT-002 ] ;
 sh:property [ sh:path sr:SR-REL-040 ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class sr:SR-CPT-003 ] ;
 sh:property [ sh:path ac:validFrom ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ; sh:lessThan ac:validTo ] ;
 sh:property [ sh:path ac:validTo ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] .
es:ScaleVersionShape a sh:NodeShape ; sh:targetClass ac:NumericScale ;
 sh:node ac:ScaleShape ; sh:node ist:VersionShape ;
 sh:not [ sh:class gufo:AbstractIndividual ] .
