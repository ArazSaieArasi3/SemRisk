@prefix sr: <urn:semrisk:entity:> .
@prefix test: <urn:semrisk:test:> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

test:fixture-v001
  dcterms:title "SemRisk P1-R2 positive smoke fixture"@en ;
  dcterms:type "TEST_FIXTURE_NOT_SEMANTIC_SOURCE" ;
  dcterms:description "Synthetic test individuals only. They are not evidence of prevalence, causality or domain validity."@en .

test:risk-001 a sr:SR-CPT-001 ;
  sr:SR-REL-003 test:event-001 ;
  sr:SR-REL-031 test:risk-state-001 ;
  sr:SR-REL-037 <urn:cm-pharme:v1.0.0:CMPE-C0001> .

test:scenario-001 a sr:SR-CPT-006 ;
  sr:SR-REL-003 test:event-001 ;
  sr:SR-REL-004 test:consequence-001 .

test:event-001 a sr:SR-CPT-007 ;
  sr:SR-REL-004 test:consequence-001 .

test:consequence-001 a sr:SR-CPT-008 .
test:risk-state-001 a sr:SR-CPT-035 .

test:description-001 a sr:SR-CPT-034 ;
  sr:SR-REL-002 test:scenario-001 .

test:entry-001 a sr:SR-CPT-033 ;
  sr:SR-REL-001 test:risk-001 ;
  sr:SR-REL-030 test:workflow-state-open .

test:workflow-state-open a sr:SR-CPT-036 .

test:assessment-001 a sr:SR-CPT-011 ;
  sr:SR-REL-013 test:risk-001 ;
  sr:SR-REL-015 test:assessment-result-001 .

test:assessment-result-001 a sr:SR-CPT-013 ;
  sr:SR-REL-016 test:risk-001 ;
  sr:SR-REL-017 test:evidence-001 .

test:evidence-001 a sr:SR-CPT-020, prov:Entity ;
  prov:wasGeneratedBy test:observation-001 .

test:observation-001 a sr:SR-CPT-022, prov:Activity .

test:responsibility-001 a sr:SR-CPT-031 ;
  sr:SR-REL-027 test:risk-001 ;
  sr:SR-REL-028 test:actor-001 .

test:actor-001 a prov:Agent .

test:strategy-001 a sr:SR-CPT-026 .
test:plan-001 a sr:SR-CPT-027 ;
  sr:SR-REL-022 test:strategy-001 .
test:treatment-001 a sr:SR-CPT-028 ;
  sr:SR-REL-023 test:plan-001 ;
  sr:SR-REL-024 test:control-001 .
test:control-001 a sr:SR-CPT-029 .

