@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix ist: <urn:semrisk:profile:information-state:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sr: <urn:semrisk:entity:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sr:SR-REL-001 rdfs:range sr:SR-CPT-001 .

sr:SR-REL-002 rdfs:domain sr:SR-CPT-034 ;
    rdfs:range sr:SR-CPT-006 .

sr:SR-REL-026 a owl:ObjectProperty ;
    rdfs:label "hasRiskOwner"@en ;
    dcterms:conformsTo "SR-REQ-006" ;
    dcterms:identifier "SR-REL-026" ;
    dcterms:relation "CQ-009; CQ-025" ;
    rdfs:comment "Derived material relation linking a Risk/managed record context to an external Actor who plays the Risk Owner role, truthmade by a Risk Responsibility assignment."@en ;
    skos:scopeNote "Derived convenience relation. Primitive truthmaker is SR-CPT-031 Risk Responsibility with SR-REL-027/028."@en .

sr:SR-REL-029 a owl:ObjectProperty ;
    rdfs:label "registerContainsEntry"@en ;
    dcterms:conformsTo "SR-REQ-001; SR-REQ-011" ;
    dcterms:identifier "SR-REL-029" ;
    dcterms:relation "CQ-001; CQ-014" ;
    rdfs:comment "Links a Risk Register to its Risk Register Entries."@en ;
    rdfs:domain sr:SR-CPT-032 ;
    rdfs:range sr:SR-CPT-033 .

sr:SR-REL-030 a owl:ObjectProperty ;
    rdfs:label "hasWorkflowState"@en ;
    dcterms:conformsTo "SR-REQ-005; SR-REQ-011; SR-REQ-019" ;
    dcterms:identifier "SR-REL-030" ;
    dcterms:relation "CQ-008; CQ-014; CQ-024; CQ-038" ;
    rdfs:comment "An unqualified workflow-status snapshot for a Risk Register Entry. Historical or as-of answers require a WorkflowAssignment with an explicit scheme and interval."@en ;
    rdfs:domain sr:SR-CPT-033 ;
    rdfs:range sr:SR-CPT-036 .

<urn:semrisk:ontology:enterprise> a owl:Ontology ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source "SemRisk issues #24 #25 #26 #43 #27" ;
    dcterms:title "SemRisk Enterprise Profile"@en ;
    owl:imports <urn:semrisk:ontology:core:0.2.0-rc.3> ;
    owl:versionIRI <urn:semrisk:ontology:enterprise:0.2.0-rc.3> ;
    owl:versionInfo "0.2.0-rc.3" .

ist:inScheme a owl:ObjectProperty ;
    rdfs:label "inScheme"@en ;
    rdfs:domain sr:SR-CPT-036 ;
    rdfs:range ist:WorkflowSchemeVersion .

ist:record a owl:ObjectProperty ;
    rdfs:label "record"@en ;
    rdfs:domain ist:WorkflowAssignment ;
    rdfs:range sr:SR-CPT-033 .

ist:scheme a owl:ObjectProperty ;
    rdfs:label "scheme"@en ;
    rdfs:domain ist:WorkflowAssignment ;
    rdfs:range ist:WorkflowSchemeVersion .

ist:value a owl:ObjectProperty ;
    rdfs:label "value"@en ;
    rdfs:domain ist:WorkflowAssignment ;
    rdfs:range sr:SR-CPT-036 .

sr:SR-CPT-032 a gufo:SubKind,
        owl:Class ;
    rdfs:label "Risk Register"@en ;
    dcterms:conformsTo "SR-REQ-001; SR-REQ-011" ;
    dcterms:identifier "SR-CPT-032" ;
    dcterms:relation "CQ-001; CQ-014; CQ-016" ;
    rdfs:comment "A governed information artifact organizing risk register entries for a defined scope; its managed identity persists as entries are added or removed."@en ;
    rdfs:subClassOf ist:ManagedInformationArtifact .

sr:SR-CPT-034 a gufo:SubKind,
        owl:Class ;
    rdfs:label "Scenario Description"@en ;
    dcterms:conformsTo "SR-REQ-002; SR-REQ-019" ;
    dcterms:identifier "SR-CPT-034" ;
    dcterms:relation "CQ-003; CQ-004; CQ-021; CQ-038" ;
    rdfs:comment "An information artifact describing a Risk Scenario, event chain, assumptions or consequences."@en ;
    rdfs:subClassOf ist:ArtifactVersion ;
    owl:disjointWith sr:SR-CPT-006,
        sr:SR-CPT-007 .

ist:WorkflowSchemeVersion a gufo:SubKind,
        owl:Class ;
    rdfs:label "WorkflowSchemeVersion"@en ;
    rdfs:subClassOf ist:ArtifactVersion .

sr:SR-CPT-033 a gufo:SubKind,
        owl:Class ;
    rdfs:label "Risk Register Entry"@en ;
    dcterms:conformsTo "SR-REQ-001; SR-REQ-011; SR-REQ-019" ;
    dcterms:identifier "SR-CPT-033" ;
    dcterms:relation "CQ-001; CQ-002; CQ-014; CQ-016; CQ-038" ;
    rdfs:comment "A governed information artifact in a risk register recording risk-related description, assessments, ownership, treatment and workflow information."@en ;
    rdfs:subClassOf ist:ManagedInformationArtifact ;
    owl:disjointWith sr:SR-CPT-001 .

sr:SR-CPT-036 a gufo:AbstractIndividualType,
        owl:Class ;
    rdfs:label "Workflow State"@en ;
    dcterms:conformsTo "SR-REQ-005; SR-REQ-011" ;
    dcterms:identifier "SR-CPT-036" ;
    dcterms:relation "CQ-008; CQ-014; CQ-024" ;
    rdfs:comment "A reusable nominal workflow-status value interpreted within an explicit scheme version; distinct from each record-specific temporal status attribution and from the underlying Risk State."@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:disjointWith sr:SR-CPT-035 ;
    skos:scopeNote "Status schemes are profile-specific. Closed is a workflow value and entails neither elimination of risk nor treatment effectiveness."@en .

ist:WorkflowAssignment a gufo:SituationType,
        owl:Class ;
    rdfs:label "WorkflowAssignment"@en ;
    rdfs:subClassOf gufo:Situation .

