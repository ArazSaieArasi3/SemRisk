@prefix sr: <urn:semrisk:entity:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:semrisk:shape:SR-SHP-001> a sh:NodeShape ;
  dcterms:identifier "SR-SHP-001" ;
  dcterms:title "Enterprise Risk Register Entry completeness"@en ;
  dcterms:conformsTo "SR-REQ-001; SR-REQ-011" ;
  sh:targetClass sr:SR-CPT-033 ;
  sh:property [
    sh:path sr:SR-REL-001 ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "An evaluated Enterprise Risk Register Entry must concern at least one Risk."@en
  ] .

<urn:semrisk:shape:SR-SHP-002> a sh:NodeShape ;
  dcterms:identifier "SR-SHP-002" ;
  dcterms:title "Enterprise workflow snapshot completeness"@en ;
  dcterms:conformsTo "SR-REQ-005" ;
  sh:targetClass sr:SR-CPT-033 ;
  sh:property [
    sh:path sr:SR-REL-030 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "A named Enterprise snapshot must expose exactly one current Workflow State; historical state assertions belong outside this snapshot shape."@en
  ] .

<urn:semrisk:shape:SR-SHP-003> a sh:NodeShape ;
  dcterms:identifier "SR-SHP-003" ;
  dcterms:title "Risk Responsibility assignment completeness"@en ;
  dcterms:conformsTo "SR-REQ-006" ;
  sh:targetClass sr:SR-CPT-031 ;
  sh:property [
    sh:path sr:SR-REL-027 ;
    sh:minCount 1 ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path sr:SR-REL-028 ;
    sh:minCount 1 ;
    sh:severity sh:Violation
  ] .

<urn:semrisk:shape:SR-SHP-004> a sh:NodeShape ;
  dcterms:identifier "SR-SHP-004" ;
  dcterms:title "Evaluation assessment-result traceability"@en ;
  dcterms:conformsTo "SR-REQ-003; SR-REQ-008; SR-REQ-017" ;
  sh:targetClass sr:SR-CPT-013 ;
  sh:property [
    sh:path sr:SR-REL-016 ;
    sh:minCount 1 ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path [ sh:inversePath sr:SR-REL-015 ] ;
    sh:minCount 1 ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path sr:SR-REL-017 ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "The Paper-1 evaluated profile requires an explicit Evidence Item for each evaluated Assessment Result."@en
  ] .

<urn:semrisk:shape:SR-SHP-005> a sh:NodeShape ;
  dcterms:identifier "SR-SHP-005" ;
  dcterms:title "Pharma bridge target presence"@en ;
  dcterms:conformsTo "SR-REQ-014; SR-REQ-015" ;
  sh:targetSubjectsOf sr:SR-REL-037 ;
  sh:property [
    sh:path sr:SR-REL-037 ;
    sh:minCount 1 ;
    sh:severity sh:Violation
  ] .
