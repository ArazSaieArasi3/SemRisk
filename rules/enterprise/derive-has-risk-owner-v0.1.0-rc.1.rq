PREFIX sr: <urn:semrisk:entity:>
PREFIX prov: <http://www.w3.org/ns/prov#>

# SR-RULE-001 — derive hasRiskOwner
# Owning module: Enterprise
# Semantics: derived convenience relation only.
# Truthmaker: SR-CPT-031 Risk Responsibility assignment.
# Inputs: SR-REL-027 assignsResponsibilityFor, SR-REL-028 responsibilityAssignedTo.
# Output: target SR-REL-026 hasRiskOwner actor.
# This rule does not create a Risk Owner individual and does not change actor identity.
#
# R2/#75 temporal application contract:
# - explicitly invalidated responsibility assignments are historical and MUST NOT
#   derive current hasRiskOwner;
# - absence of prov:invalidatedAtTime is interpreted only inside the governed
#   application graph as "not explicitly ended". Under OWL OWA this absence is
#   not a universal proof that the assignment is current.
# - richer scheduled/future interval semantics remain an application/RDB concern
#   unless a separate governed temporal vocabulary is introduced.

CONSTRUCT {
  ?target sr:SR-REL-026 ?actor .
}
WHERE {
  ?responsibility a sr:SR-CPT-031 ;
                  sr:SR-REL-027 ?target ;
                  sr:SR-REL-028 ?actor .
  FILTER NOT EXISTS { ?responsibility prov:invalidatedAtTime ?invalidatedAt . }
}
