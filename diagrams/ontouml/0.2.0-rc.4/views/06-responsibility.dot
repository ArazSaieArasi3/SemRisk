"SR-CPT-030" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#40546c" BGCOLOR="#e7f2fc"><TR><TD><FONT POINT-SIZE="11">«roleMixin»</FONT></TD></TR><TR><TD><B>Risk Owner</B></TD></TR></TABLE>>];
"SR-CPT-031" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#40546c" BGCOLOR="#e7f2fc"><TR><TD><FONT POINT-SIZE="11">«relator»</FONT></TD></TR><TR><TD><B>Risk Responsibility</B></TD></TR></TABLE>>];
"SR-CPT-033" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#40546c" BGCOLOR="#e7f2fc"><TR><TD><FONT POINT-SIZE="11">«subkind»</FONT></TD></TR><TR><TD><B>Risk Register Entry</B></TD></TR></TABLE>>];
"SR-CPT-001" -> "B-Actor" [arrowhead=none, label="/hasRiskOwner", taillabel="0..*", headlabel="0..*", labeldistance=1.8, id="SR-REL-026-view-1-1"];
