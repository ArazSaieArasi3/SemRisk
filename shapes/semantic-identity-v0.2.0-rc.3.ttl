@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sr: <urn:semrisk:entity:> .
@prefix ist: <urn:semrisk:profile:information-state:> .
@prefix ac: <urn:semrisk:profile:assessment-context:> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ist:ScenarioShape a sh:NodeShape ; sh:targetClass sr:SR-CPT-006 ;
 sh:nodeKind sh:IRI ;
 sh:property [ sh:path rdf:type ; sh:hasValue owl:Class ] ;
 sh:property [ sh:path rdfs:subClassOf ; sh:hasValue gufo:Situation ] ;
 sh:not [ sh:class gufo:Individual ] .

# Explicitly opted-in version instances; old unqualified artifacts are not silently declared complete.
ist:VersionShape a sh:NodeShape ; sh:targetClass ist:ArtifactVersion ;
 sh:nodeKind sh:IRI ;
 sh:property [ sh:path ist:versionOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class ist:ManagedInformationArtifact ] ;
 sh:property [ sh:path ist:expressesContent ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class ist:InformationContent ] ;
 sh:sparql [ sh:message "VERSION_SELF: a version must differ explicitly from its series artifact." ; sh:select """
 PREFIX ist: <urn:semrisk:profile:information-state:>
 PREFIX owl: <http://www.w3.org/2002/07/owl#>
 SELECT $this WHERE { $this ist:versionOf ?a . FILTER($this = ?a || EXISTS {$this (owl:sameAs|^owl:sameAs)+ ?a} || NOT EXISTS {$this (owl:differentFrom|^owl:differentFrom) ?a}) }
 """ ] .

ist:ValueShape a sh:NodeShape ; sh:targetClass sr:SR-CPT-036 ; sh:nodeKind sh:IRI ;
 sh:property [ sh:path ist:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class ist:WorkflowSchemeVersion ] ;
 sh:not [ sh:class gufo:Quality ] ; sh:not [ sh:class sr:SR-CPT-035 ] .

ist:AssignmentShape a sh:NodeShape ; sh:targetClass ist:WorkflowAssignment ; sh:nodeKind sh:IRI ;
 sh:property [ sh:path ist:record ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class sr:SR-CPT-033 ] ;
 sh:property [ sh:path ist:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class sr:SR-CPT-036 ] ;
 sh:property [ sh:path ist:scheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class ist:WorkflowSchemeVersion ] ;
 sh:property [ sh:path ac:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ; sh:lessThan ac:validTo ] ;
 sh:property [ sh:path ac:validTo ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" ] ;
 sh:sparql [ sh:message "WORKFLOW_SCHEME: assignment and value must use the same scheme version." ; sh:select """
 PREFIX ist: <urn:semrisk:profile:information-state:>
 SELECT $this WHERE { $this ist:value ?v ; ist:scheme ?s . FILTER NOT EXISTS { ?v ist:inScheme ?s } }
 """ ] ;
 sh:sparql [ sh:message "WORKFLOW_OVERLAP: assignments for the same entry and scheme must not overlap." ; sh:select """
 PREFIX ist: <urn:semrisk:profile:information-state:>
 PREFIX ac: <urn:semrisk:profile:assessment-context:>
 SELECT $this WHERE {
 $this ist:record ?r ; ist:scheme ?s ; ac:validFrom ?a . OPTIONAL {$this ac:validTo ?b}
 ?other a ist:WorkflowAssignment ; ist:record ?r ; ist:scheme ?s ; ac:validFrom ?c . OPTIONAL {?other ac:validTo ?d}
 FILTER($this != ?other && (!BOUND(?b) || ?c < ?b) && (!BOUND(?d) || ?a < ?d))
 }
 """ ] .
