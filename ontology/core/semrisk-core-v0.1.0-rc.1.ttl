@prefix sr: <urn:semrisk:entity:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:semrisk:ontology:core> a owl:Ontology ;
  owl:versionIRI <urn:semrisk:ontology:core:0.1.0-rc.1> ;
  owl:versionInfo "0.1.0-rc.1" ;
  dcterms:title "SemRisk Core Ontology"@en ;
  dcterms:created "2026-09-23"^^xsd:date ;
  dcterms:source "SemRisk issues #24 #25 #26 #43 #27" ;
  owl:imports <http://purl.org/nemo/gufo#/1.0.0> .

sr:SR-CPT-001 a owl:Class ;
  dcterms:identifier "SR-CPT-001" ;
  rdfs:label "Risk"@en ;
  rdfs:comment "A context-dependent risk phenomenon or pattern concerning possible effects on value/objectives; distinct from records, descriptions, scores and workflow artifacts."@en ;
  skos:scopeNote "Paper-1 identity continuity is governed by a stable semantic identity and the #69 identity/continuity contract. Mutable record, assessment, state, ownership and treatment fields do not automatically define or replace Risk identity."@en ;
  dcterms:conformsTo "SR-REQ-001; SR-REQ-019" ;
  dcterms:relation "CQ-001; CQ-002; CQ-016" .

sr:SR-CPT-002 a owl:Class ;
  dcterms:identifier "SR-CPT-002" ;
  rdfs:label "Risk Subject"@en ;
  rdfs:comment "An entity, value-bearing object or externally owned item about which risk relevance is asserted."@en ;
  dcterms:conformsTo "SR-REQ-010" ;
  dcterms:relation "CQ-013; CQ-017" ;
  a gufo:RoleMixin .

sr:SR-CPT-003 a owl:Class ;
  dcterms:identifier "SR-CPT-003" ;
  rdfs:label "Risk Source"@en ;
  rdfs:comment "A risk-relevant origin, source or contextual contributor that may participate in a scenario or event; causal status is not implied by the label alone."@en ;
  skos:scopeNote "Cross-category contextual/source role pattern. Do not force Risk Source under one gUFO primitive; use typed refinements when the underlying category is known."@en ;
  dcterms:conformsTo "SR-REQ-009" ;
  dcterms:relation "CQ-012; CQ-028" .

sr:SR-CPT-004 a owl:Class ;
  dcterms:identifier "SR-CPT-004" ;
  rdfs:label "Predisposing Condition"@en ;
  rdfs:comment "A contextual state-of-affairs or situational condition that increases susceptibility to a risk-relevant event/effect without necessarily directly causing it."@en ;
  skos:scopeNote "Intrinsic disposition-like susceptibility belongs under Vulnerability or an explicit profile refinement; Predisposing Condition remains situational in the Paper-1 Core."@en ;
  dcterms:conformsTo "SR-REQ-009" ;
  dcterms:relation "CQ-012; CQ-028" ;
  rdfs:subClassOf gufo:Situation .

sr:SR-CPT-005 a owl:Class ;
  dcterms:identifier "SR-CPT-005" ;
  rdfs:label "Trigger"@en ;
  rdfs:comment "A condition or occurrence that initiates or activates a transition in a risk-relevant scenario, event, monitoring or response process."@en ;
  dcterms:conformsTo "SR-REQ-009" ;
  dcterms:relation "CQ-012" ;
  rdfs:subClassOf gufo:Event .

sr:SR-CPT-006 a owl:Class ;
  dcterms:identifier "SR-CPT-006" ;
  rdfs:label "Risk Scenario"@en ;
  rdfs:comment "A possible or hypothesized risk-relevant configuration or event pattern used for analysis, distinct from descriptions and realized events."@en ;
  dcterms:conformsTo "SR-REQ-002" ;
  dcterms:relation "CQ-003; CQ-004; CQ-021" ;
  a gufo:SituationType .

sr:SR-CPT-007 a owl:Class ;
  dcterms:identifier "SR-CPT-007" ;
  rdfs:label "Risk Event"@en ;
  rdfs:comment "A realized occurrence relevant to a risk context, distinct from a possible scenario and information artifacts describing it."@en ;
  dcterms:conformsTo "SR-REQ-002; SR-REQ-009" ;
  dcterms:relation "CQ-003; CQ-012; CQ-021" ;
  rdfs:subClassOf gufo:Event .

sr:SR-CPT-008 a owl:Class ;
  dcterms:identifier "SR-CPT-008" ;
  rdfs:label "Consequence"@en ;
  rdfs:comment "A risk-relevant outcome or effect of an event/scenario; its magnitude/severity may be assessed separately."@en ;
  dcterms:conformsTo "SR-REQ-009; SR-REQ-013" ;
  dcterms:relation "CQ-012; CQ-019" ;
  rdfs:subClassOf gufo:Situation .

sr:SR-CPT-009 a owl:Class ;
  dcterms:identifier "SR-CPT-009" ;
  rdfs:label "Vulnerability"@en ;
  rdfs:comment "A disposition or condition that increases susceptibility to a risk-relevant event/effect."@en ;
  dcterms:conformsTo "SR-REQ-009" ;
  dcterms:relation "CQ-012" ;
  rdfs:subClassOf gufo:IntrinsicMode .

sr:SR-CPT-010 a owl:Class ;
  dcterms:identifier "SR-CPT-010" ;
  rdfs:label "Exposure"@en ;
  rdfs:comment "A context-dependent condition or relation indicating how a subject/value is exposed to a risk-relevant source/event; assessment scores remain separate."@en ;
  dcterms:conformsTo "SR-REQ-009; SR-REQ-013" ;
  dcterms:relation "CQ-012; CQ-019" ;
  rdfs:subClassOf gufo:Situation .

sr:SR-CPT-011 a owl:Class ;
  dcterms:identifier "SR-CPT-011" ;
  rdfs:label "Risk Assessment Activity"@en ;
  rdfs:comment "An activity applying a method, context and evidence to produce one or more risk assessment results."@en ;
  dcterms:conformsTo "SR-REQ-003; SR-REQ-012" ;
  dcterms:relation "CQ-005; CQ-006; CQ-015; CQ-022" ;
  rdfs:subClassOf gufo:Event .

sr:SR-CPT-013 a owl:Class ;
  dcterms:identifier "SR-CPT-013" ;
  rdfs:label "Risk Assessment Result"@en ;
  rdfs:comment "A contextual, time-bound information/measurement result produced by a Risk Assessment Activity concerning a risk subject/context."@en ;
  dcterms:conformsTo "SR-REQ-003; SR-REQ-004; SR-REQ-012" ;
  dcterms:relation "CQ-005; CQ-006; CQ-007; CQ-015; CQ-022; CQ-031" .

sr:SR-CPT-014 a owl:Class ;
  dcterms:identifier "SR-CPT-014" ;
  rdfs:label "Likelihood Assessment Result"@en ;
  rdfs:comment "An assessment result concerning estimated likelihood/probability/frequency under a specified method and context."@en ;
  dcterms:conformsTo "SR-REQ-013" ;
  dcterms:relation "CQ-019; CQ-032" ;
  rdfs:subClassOf sr:SR-CPT-013 .

sr:SR-CPT-015 a owl:Class ;
  dcterms:identifier "SR-CPT-015" ;
  rdfs:label "Impact Assessment Result"@en ;
  rdfs:comment "An assessment result concerning magnitude/severity of effects under a specified assessment method/context."@en ;
  dcterms:conformsTo "SR-REQ-013" ;
  dcterms:relation "CQ-019" ;
  rdfs:subClassOf sr:SR-CPT-013 .

sr:SR-CPT-017 a owl:Class ;
  dcterms:identifier "SR-CPT-017" ;
  rdfs:label "Inherent Risk Assessment Result"@en ;
  rdfs:comment "A risk assessment result representing a pre-treatment/pre-control assessment context."@en ;
  skos:scopeNote "Framework labels such as gross risk require explicit method/profile mapping and are not universal synonyms of inherent risk."@en ;
  dcterms:conformsTo "SR-REQ-004" ;
  dcterms:relation "CQ-007; CQ-023" ;
  rdfs:subClassOf sr:SR-CPT-013 .

sr:SR-CPT-018 a owl:Class ;
  dcterms:identifier "SR-CPT-018" ;
  rdfs:label "Residual Risk Assessment Result"@en ;
  rdfs:comment "A risk assessment result representing a post-treatment/control assessment context."@en ;
  skos:scopeNote "Current, net, target or desired risk labels require explicit method/profile mapping; none is universally equivalent to residual risk."@en ;
  dcterms:conformsTo "SR-REQ-004" ;
  dcterms:relation "CQ-007; CQ-023" ;
  rdfs:subClassOf sr:SR-CPT-013 .

sr:SR-CPT-020 a owl:Class ;
  dcterms:identifier "SR-CPT-020" ;
  rdfs:label "Evidence Item"@en ;
  rdfs:comment "An information artifact used in context to support, challenge or contextualize a risk-related assertion, assessment or decision."@en ;
  dcterms:conformsTo "SR-REQ-008; SR-REQ-017" ;
  dcterms:relation "CQ-011; CQ-027; CQ-037" .

sr:SR-CPT-022 a owl:Class ;
  dcterms:identifier "SR-CPT-022" ;
  rdfs:label "Observation Activity"@en ;
  rdfs:comment "An activity that observes/measures risk-relevant phenomena and may produce observation results."@en ;
  dcterms:conformsTo "SR-REQ-008" ;
  dcterms:relation "CQ-011; CQ-030" ;
  rdfs:subClassOf gufo:Event .

sr:SR-CPT-023 a owl:Class ;
  dcterms:identifier "SR-CPT-023" ;
  rdfs:label "Observation Result"@en ;
  rdfs:comment "An information/measurement result produced by an observation/monitoring activity and potentially used as evidence."@en ;
  dcterms:conformsTo "SR-REQ-008" ;
  dcterms:relation "CQ-011; CQ-030" .

sr:SR-CPT-026 a owl:Class ;
  dcterms:identifier "SR-CPT-026" ;
  rdfs:label "Risk Treatment Strategy"@en ;
  rdfs:comment "A decision/information artifact specifying a high-level selected approach for addressing a risk."@en ;
  dcterms:conformsTo "SR-REQ-007" ;
  dcterms:relation "CQ-010; CQ-026" .

sr:SR-CPT-027 a owl:Class ;
  dcterms:identifier "SR-CPT-027" ;
  rdfs:label "Risk Treatment Plan"@en ;
  rdfs:comment "An information artifact specifying planned treatment activities, responsibilities, timing or resources."@en ;
  dcterms:conformsTo "SR-REQ-007" ;
  dcterms:relation "CQ-010; CQ-026" .

sr:SR-CPT-028 a owl:Class ;
  dcterms:identifier "SR-CPT-028" ;
  rdfs:label "Risk Treatment Activity"@en ;
  rdfs:comment "An activity performed to modify risk-relevant conditions, likelihood, consequences or preparedness."@en ;
  dcterms:conformsTo "SR-REQ-007" ;
  dcterms:relation "CQ-010; CQ-026" ;
  rdfs:subClassOf gufo:Event .

sr:SR-CPT-029 a owl:Class ;
  dcterms:identifier "SR-CPT-029" ;
  rdfs:label "Control Mechanism"@en ;
  rdfs:comment "A persistent mechanism, capability or implemented measure used in prevention, detection, protection or risk treatment."@en ;
  skos:scopeNote "Existence or use of a Control Mechanism does not entail design adequacy, operating effectiveness, assurance success, or risk reduction."@en ;
  dcterms:conformsTo "SR-REQ-007; SR-REQ-010" ;
  dcterms:relation "CQ-010; CQ-013; CQ-026" ;
  a gufo:RoleMixin .

sr:SR-CPT-030 a owl:Class ;
  dcterms:identifier "SR-CPT-030" ;
  rdfs:label "Risk Owner"@en ;
  rdfs:comment "A context-dependent role borne by an actor with responsibility/accountability for specified risk-management obligations."@en ;
  skos:scopeNote "Paper 1 permits multiple valid responsibility assignments/co-owners and does not impose a unique-owner cardinality; delegation/RACI/committee authority remain profile-level future refinements."@en ;
  dcterms:conformsTo "SR-REQ-006" ;
  dcterms:relation "CQ-009; CQ-025" ;
  a gufo:Role .

sr:SR-CPT-031 a owl:Class ;
  dcterms:identifier "SR-CPT-031" ;
  rdfs:label "Risk Responsibility"@en ;
  rdfs:comment "A concrete responsibility/accountability assignment context that depends on an Actor/role bearer and any modeled governance participants, and is about the Risk, artifact, plan or obligation it concerns."@en ;
  skos:scopeNote "Under the #71 grounding contract, mediation applies to endurant participants; the derived Risk pattern is an aboutness/assignment target rather than a mediated endurant."@en ;
  dcterms:conformsTo "SR-REQ-006" ;
  dcterms:relation "CQ-009; CQ-025" ;
  rdfs:subClassOf gufo:Relator .

sr:SR-CPT-035 a owl:Class ;
  dcterms:identifier "SR-CPT-035" ;
  rdfs:label "Risk State"@en ;
  rdfs:comment "A time- and context-bound state-of-affairs concerning the governed Risk context, distinct from assessment results, record/workflow progression and management/monitoring classifications."@en ;
  skos:scopeNote "Core Risk State is situational. Workflow, management-attention, escalation and monitoring classifications stay outside this class unless a later profile explicitly introduces them."@en ;
  dcterms:conformsTo "SR-REQ-005; SR-REQ-019" ;
  dcterms:relation "CQ-008; CQ-024; CQ-038" ;
  rdfs:subClassOf gufo:Situation .

sr:SR-CPT-021 a skos:Concept ;
  dcterms:identifier "SR-CPT-021" ;
  rdfs:label "Provenance"@en ;
  rdfs:comment "Information about origin, derivation, version, agent, time and transformation history of an artifact/assertion/result."@en ;
  dcterms:conformsTo "SR-REQ-008; SR-REQ-017" ;
  dcterms:relation "CQ-011; CQ-027; CQ-037; CQ-038" ;
  skos:scopeNote "Formal realization uses qualified PROV-O patterns; this node is a conceptual registry marker, not a domain class."@en .

sr:SR-REL-001 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-001" ;
  rdfs:label "concernsRisk"@en ;
  rdfs:comment "Links a Risk Register Entry or Scenario Description to the Risk it concerns."@en ;
  skos:scopeNote "No global OWL domain is asserted: using concernsRisk must not infer that every subject is a Risk Register Entry. Register-entry completeness is a SHACL/profile constraint."@en ;
  dcterms:conformsTo "SR-REQ-001; SR-REQ-019" ;
  dcterms:relation "CQ-001; CQ-002; CQ-016; CQ-038" .

sr:SR-REL-002 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-002" ;
  rdfs:label "describesScenario"@en ;
  rdfs:comment "Links a Scenario Description to the Risk Scenario it describes."@en ;
  dcterms:conformsTo "SR-REQ-002; SR-REQ-019" ;
  dcterms:relation "CQ-003; CQ-004; CQ-021" .

sr:SR-REL-003 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-003" ;
  rdfs:label "realizedAs"@en ;
  rdfs:comment "Links a Risk Scenario to a realized Risk Event when realization evidence exists."@en ;
  dcterms:conformsTo "SR-REQ-002" ;
  dcterms:relation "CQ-003; CQ-021" ;
  rdfs:domain sr:SR-CPT-006 ;
  rdfs:range sr:SR-CPT-007 .

sr:SR-REL-004 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-004" ;
  rdfs:label "hasConsequence"@en ;
  rdfs:comment "Links a Risk Event or Risk Scenario to a Consequence."@en ;
  dcterms:conformsTo "SR-REQ-009" ;
  dcterms:relation "CQ-012; CQ-028" ;
  rdfs:range sr:SR-CPT-008 .

sr:SR-REL-005 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-005" ;
  rdfs:label "hasRiskSource"@en ;
  rdfs:comment "Links a Risk or Risk Scenario to a Risk Source considered relevant."@en ;
  dcterms:conformsTo "SR-REQ-009" ;
  dcterms:relation "CQ-012" ;
  rdfs:range sr:SR-CPT-003 .

sr:SR-REL-006 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-006" ;
  rdfs:label "predisposedBy"@en ;
  rdfs:comment "Links a Risk Scenario/Event context to a Predisposing Condition."@en ;
  dcterms:conformsTo "SR-REQ-009" ;
  dcterms:relation "CQ-012; CQ-028" ;
  rdfs:range sr:SR-CPT-004 .

sr:SR-REL-007 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-007" ;
  rdfs:label "triggeredBy"@en ;
  rdfs:comment "Links a Risk Event or process transition to a Trigger."@en ;
  dcterms:conformsTo "SR-REQ-009" ;
  dcterms:relation "CQ-012" ;
  rdfs:domain sr:SR-CPT-007 ;
  rdfs:range sr:SR-CPT-005 .

sr:SR-REL-008 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-008" ;
  rdfs:label "causes"@en ;
  rdfs:comment "Asserts causal dependence supported by explicit evidence/model assumptions."@en ;
  dcterms:conformsTo "SR-REQ-009" ;
  dcterms:relation "CQ-012; CQ-028" .

sr:SR-REL-009 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-009" ;
  rdfs:label "associatedWith"@en ;
  rdfs:comment "Represents non-causal association/dependency between risk-relevant entities."@en ;
  dcterms:conformsTo "SR-REQ-009" ;
  dcterms:relation "CQ-012; CQ-028" .

sr:SR-REL-010 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-010" ;
  rdfs:label "affects"@en ;
  rdfs:comment "Links Risk/Event/Consequence to an externally owned Objective, Capability, Process or Risk Subject."@en ;
  dcterms:conformsTo "SR-REQ-010" ;
  dcterms:relation "CQ-013; CQ-017" .

sr:SR-REL-011 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-011" ;
  rdfs:label "exposes"@en ;
  rdfs:comment "Links a Risk Source/Condition to a Risk Subject under a relevant context."@en ;
  dcterms:conformsTo "SR-REQ-009; SR-REQ-010" ;
  dcterms:relation "CQ-012; CQ-013" .

sr:SR-REL-012 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-012" ;
  rdfs:label "hasVulnerability"@en ;
  rdfs:comment "Links a Risk Subject/context to a Vulnerability."@en ;
  dcterms:conformsTo "SR-REQ-009" ;
  dcterms:relation "CQ-012" ;
  rdfs:range sr:SR-CPT-009 .

sr:SR-REL-013 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-013" ;
  rdfs:label "performedAssessmentOf"@en ;
  rdfs:comment "Links a Risk Assessment Activity to the Risk/context assessed."@en ;
  dcterms:conformsTo "SR-REQ-003; SR-REQ-012" ;
  dcterms:relation "CQ-005; CQ-006; CQ-015" ;
  rdfs:domain sr:SR-CPT-011 ;
  rdfs:range sr:SR-CPT-001 .

sr:SR-REL-015 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-015" ;
  rdfs:label "producesAssessmentResult"@en ;
  rdfs:comment "Links an assessment activity to a produced assessment result."@en ;
  dcterms:conformsTo "SR-REQ-003; SR-REQ-012" ;
  dcterms:relation "CQ-005; CQ-006; CQ-022" ;
  rdfs:domain sr:SR-CPT-011 ;
  rdfs:range sr:SR-CPT-013 .

sr:SR-REL-016 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-016" ;
  rdfs:label "assessmentResultConcerns"@en ;
  rdfs:comment "Links an assessment result to the Risk/context it evaluates."@en ;
  dcterms:conformsTo "SR-REQ-003; SR-REQ-004; SR-REQ-019" ;
  dcterms:relation "CQ-007; CQ-015; CQ-031" ;
  rdfs:domain sr:SR-CPT-013 ;
  rdfs:range sr:SR-CPT-001 .

sr:SR-REL-017 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-017" ;
  rdfs:label "supportedByEvidence"@en ;
  rdfs:comment "Links an assessment/result/assertion to Evidence Item(s)."@en ;
  dcterms:conformsTo "SR-REQ-008; SR-REQ-012; SR-REQ-017" ;
  dcterms:relation "CQ-006; CQ-011; CQ-027; CQ-037" ;
  rdfs:range sr:SR-CPT-020 .

sr:SR-REL-018 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-018" ;
  rdfs:label "generatedByObservation"@en ;
  rdfs:comment "Links an Observation Result to its Observation Activity."@en ;
  dcterms:conformsTo "SR-REQ-008" ;
  dcterms:relation "CQ-011" ;
  rdfs:domain sr:SR-CPT-023 ;
  rdfs:range sr:SR-CPT-022 .

sr:SR-REL-019 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-019" ;
  rdfs:label "hasProvenance"@en ;
  rdfs:comment "Links an artifact/result/assertion to provenance information."@en ;
  dcterms:conformsTo "SR-REQ-008; SR-REQ-017" ;
  dcterms:relation "CQ-011; CQ-027; CQ-037; CQ-038" ;
  skos:scopeNote "Compatibility umbrella only; qualified PROV-O generation/derivation/attribution is normative."@en .

sr:SR-REL-021 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-021" ;
  rdfs:label "selectsTreatmentStrategy"@en ;
  rdfs:comment "Links a risk-management decision/context to a Risk Treatment Strategy."@en ;
  dcterms:conformsTo "SR-REQ-007" ;
  dcterms:relation "CQ-010; CQ-026" ;
  rdfs:range sr:SR-CPT-026 .

sr:SR-REL-022 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-022" ;
  rdfs:label "planImplementsStrategy"@en ;
  rdfs:comment "Links a Risk Treatment Plan to a Treatment Strategy."@en ;
  dcterms:conformsTo "SR-REQ-007" ;
  dcterms:relation "CQ-010; CQ-026" ;
  rdfs:domain sr:SR-CPT-027 ;
  rdfs:range sr:SR-CPT-026 .

sr:SR-REL-023 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-023" ;
  rdfs:label "activityExecutesPlan"@en ;
  rdfs:comment "Links a Risk Treatment Activity to the Plan it executes."@en ;
  dcterms:conformsTo "SR-REQ-007" ;
  dcterms:relation "CQ-010; CQ-026" ;
  rdfs:domain sr:SR-CPT-028 ;
  rdfs:range sr:SR-CPT-027 .

sr:SR-REL-024 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-024" ;
  rdfs:label "activityUsesControl"@en ;
  rdfs:comment "Links a Risk Treatment Activity to a Control Mechanism it deploys/uses."@en ;
  dcterms:conformsTo "SR-REQ-007" ;
  dcterms:relation "CQ-010; CQ-026" ;
  rdfs:domain sr:SR-CPT-028 ;
  rdfs:range sr:SR-CPT-029 .

sr:SR-REL-025 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-025" ;
  rdfs:label "controlProtects"@en ;
  rdfs:comment "Links a Control Mechanism to a Risk Subject/Objective/Process it protects or modifies."@en ;
  dcterms:conformsTo "SR-REQ-007; SR-REQ-010" ;
  dcterms:relation "CQ-010; CQ-013" ;
  rdfs:domain sr:SR-CPT-029 .

sr:SR-REL-027 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-027" ;
  rdfs:label "assignsResponsibilityFor"@en ;
  rdfs:comment "Links Risk Responsibility/assignment to the relevant Risk/artifact/obligation."@en ;
  dcterms:conformsTo "SR-REQ-006; SR-REQ-019" ;
  dcterms:relation "CQ-009; CQ-038" ;
  rdfs:domain sr:SR-CPT-031 .

sr:SR-REL-028 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-028" ;
  rdfs:label "responsibilityAssignedTo"@en ;
  rdfs:comment "Links a Risk Responsibility assignment to the Actor/Role bearer."@en ;
  dcterms:conformsTo "SR-REQ-006; SR-REQ-019" ;
  dcterms:relation "CQ-009; CQ-038" ;
  rdfs:domain sr:SR-CPT-031 .

sr:SR-REL-031 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-031" ;
  rdfs:label "hasRiskState"@en ;
  rdfs:comment "Links a Risk/context to Risk State."@en ;
  dcterms:conformsTo "SR-REQ-005; SR-REQ-019" ;
  dcterms:relation "CQ-008; CQ-024; CQ-038" ;
  rdfs:domain sr:SR-CPT-001 ;
  rdfs:range sr:SR-CPT-035 .

sr:SR-REL-032 a owl:ObjectProperty ;
  dcterms:identifier "SR-REL-032" ;
  rdfs:label "precedesState"@en ;
  rdfs:comment "Links a historical state to a later state within the same state dimension."@en ;
