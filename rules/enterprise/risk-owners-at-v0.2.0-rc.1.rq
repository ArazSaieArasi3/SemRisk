PREFIX sr: <urn:semrisk:entity:>
PREFIX ac: <urn:semrisk:profile:assessment-context:>
PREFIX prov: <http://www.w3.org/ns/prov#>
# Caller must bind ?asOf to a timezone-aware xsd:dateTime. No ambient NOW().
SELECT DISTINCT ?risk ?actor WHERE {
 ?assignment a sr:SR-CPT-031; sr:SR-REL-027 ?risk; sr:SR-REL-028 ?actor; ac:validFrom ?start .
 OPTIONAL { ?assignment ac:validTo ?end }
 OPTIONAL { ?assignment prov:invalidatedAtTime ?invalidated }
 FILTER(BOUND(?asOf) && ?start <= ?asOf && (!BOUND(?end) || ?asOf < ?end) && (!BOUND(?invalidated) || ?asOf < ?invalidated))
}
ORDER BY ?risk ?actor
