@prefix sr: <urn:semrisk:entity:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:semrisk:ontology:mappings> a owl:Ontology ;
  owl:versionIRI <urn:semrisk:ontology:mappings:0.1.0-rc.1> ;
  owl:versionInfo "0.1.0-rc.1" ;
  dcterms:title "SemRisk External Mapping Package"@en ;
  dcterms:created "2026-09-23"^^xsd:date ;
  dcterms:source "SemRisk issues #24 #25 #26 #43 #27" ;
  owl:imports <urn:semrisk:ontology:core:0.1.0-rc.1>;
  owl:imports <urn:semrisk:ontology:enterprise:0.1.0-rc.1>;
  owl:imports <urn:semrisk:ontology:pharma:0.1.0-rc.1> .

sr:SR-CPT-037 a skos:Concept ;
  dcterms:identifier "SR-CPT-037" ;
  rdfs:label "Objective"@en ;
  rdfs:comment "An externally owned enterprise/governance objective that may be affected by or provide context for risk."@en ;
  dcterms:conformsTo "SR-REQ-010" ;
  dcterms:relation "CQ-013; CQ-017" ;
  skos:scopeNote "Externally owned semantic descriptor; deliberately not asserted as a local owl:Class. Generic canonical owner remains unbound in Paper 1; TOGAF 10 and ArchiMate 3.2 are reference/alignment sources, not asserted semantic owners."@en .

sr:SR-CPT-038 a skos:Concept ;
  dcterms:identifier "SR-CPT-038" ;
  rdfs:label "Capability"@en ;
  rdfs:comment "An externally owned enterprise capability that may be exposed to/affected by risk."@en ;
  dcterms:conformsTo "SR-REQ-010" ;
  dcterms:relation "CQ-013; CQ-017" ;
  skos:scopeNote "Externally owned semantic descriptor; deliberately not asserted as a local owl:Class. Generic canonical owner remains unbound in Paper 1; TOGAF 10 and ArchiMate 3.2 are reference/alignment sources, not asserted semantic owners."@en .

sr:SR-CPT-039 a skos:Concept ;
  dcterms:identifier "SR-CPT-039" ;
  rdfs:label "Business Process"@en ;
  rdfs:comment "An externally owned process/business activity context that may generate, encounter or be affected by risk."@en ;
  dcterms:conformsTo "SR-REQ-010" ;
  dcterms:relation "CQ-013; CQ-017" ;
  skos:scopeNote "Externally owned semantic descriptor; deliberately not asserted as a local owl:Class. Generic canonical owner remains unbound in Paper 1; TOGAF 10 and ArchiMate 3.2 are reference/alignment sources, not asserted semantic owners."@en .

sr:SR-REL-038 a owl:AnnotationProperty ;
  dcterms:identifier "SR-REL-038" ;
  rdfs:label "profileExtendsCoreConcept"@en ;
  rdfs:comment "Architecture metadata relation; not a domain object property."@en .

sr:SR-CPT-001 skos:relatedMatch <https://purl.org/krdb-core/cover#Risk> .
sr:SR-CPT-002 skos:closeMatch <https://purl.org/krdb-core/cover#RiskSubject> ;
  skos:relatedMatch <https://purl.org/krdb-core/cover#ObjectAtRisk> .
sr:SR-CPT-007 skos:closeMatch <https://purl.org/krdb-core/cover#RiskEvent>, <http://rose.com#RiskEvent> .
sr:SR-CPT-009 skos:closeMatch <https://purl.org/krdb-core/cover#Vulnerability>, <http://rose.com#Vulnerability> .
sr:SR-CPT-005 skos:relatedMatch <https://purl.org/krdb-core/cover#TriggerEvent> .
sr:SR-CPT-008 skos:relatedMatch <https://purl.org/krdb-core/cover#ImpactfulOutcome> .
sr:SR-CPT-011 skos:relatedMatch <https://purl.org/krdb-core/cover#RiskAssessment>, <http://rose.com#RiskAssessment> .
sr:SR-CPT-013 skos:relatedMatch <https://purl.org/krdb-core/cover#RiskAssessment>, <http://rose.com#RiskAssessment> .
sr:SR-CPT-014 skos:relatedMatch <https://purl.org/krdb-core/cover#Likelihood> .
sr:SR-CPT-029 skos:relatedMatch <http://rose.com#SecurityMechanism> .
sr:SR-REL-008 skos:relatedMatch <http://rose.com#causes_2>, <http://rose.com#directlyCauses>, <http://rose.com#causation> .
sr:SR-REL-025 skos:relatedMatch <http://rose.com#countermeasureTo>, <http://rose.com#prevention> .

<urn:cm-pharme:v1.0.0:CMPE-C0001> a skos:Concept ; skos:prefLabel "Pharmaceutical Enterprise"@en ; dcterms:source "CM-PharmE v1.0.0 CMPE-C0001" .
<urn:cm-pharme:v1.0.0:CMPE-C0005> a skos:Concept ; skos:prefLabel "Enterprise Capability"@en ; dcterms:source "CM-PharmE v1.0.0 CMPE-C0005" .
<urn:cm-pharme:v1.0.0:CMPE-C0015> a skos:Concept ; skos:prefLabel "Pharmaceutical Business Process"@en ; dcterms:source "CM-PharmE v1.0.0 CMPE-C0015" .
<urn:cm-pharme:v1.0.0:CMPE-C0011> a skos:Concept ; skos:prefLabel "Ecosystem Supply Capacity"@en ; dcterms:source "CM-PharmE v1.0.0 CMPE-C0011" .
<urn:cm-pharme:v1.0.0:CMPE-C0032> a skos:Concept ; skos:prefLabel "Supply Chain Relationship"@en ; dcterms:source "CM-PharmE v1.0.0 CMPE-C0032" .
