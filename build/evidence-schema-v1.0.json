{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemRisk semantic CI evidence",
  "type": "object",
  "required": ["schema_version", "candidate", "commit", "tools", "checks", "inventory"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate": {"type": "string"},
    "commit": {"type": "string"},
    "tools": {"type": "object"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "family", "status", "message"],
        "properties": {
          "id": {"type": "string"},
          "family": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "WARNING", "ERROR", "UNSUPPORTED", "NOT_RUN", "N-A"]},
          "message": {"type": "string"}
        }
      }
    },
    "inventory": {"type": "object"}
  }
}
